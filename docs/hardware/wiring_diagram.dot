digraph wiring {
  graph [rankdir=LR, bgcolor=white, pad=0.25, nodesep=0.35, ranksep=0.6, fontname="Helvetica", labelloc=t, label="Detailed controller wiring — ESP32 DevKit pin assignments", fontsize=16];
  node [shape=box, style=solid, color=black, fontcolor=black, fontname="Helvetica", fontsize=9, margin="0.10,0.06", penwidth=1];
  edge [color=black, fontcolor=black, fontname="Helvetica", fontsize=8, arrowsize=0.65, penwidth=1];
  esp [label="ESP32 DevKit\n3V3 · GND\nGPIO 4,13,14,18,19,21,22,23,25,26,27,32,33"];
  rfid [label="RC522\n3V3 · GND\nSCK · MISO · MOSI\nSDA/SS · RST"];
  oled [label="SSD1306 I²C\n3.3-V logic · VCC · GND\nSDA · SCL · addr 0x3C"];
  servo [label="SG90 tabletop gate\nSignal · +5V · GND"];
  servosupply [label="Separate regulated\n5-V servo supply\n≥1 A initial provision"];
  leds [label="LED1 GPIO25 · LED2 GPIO26\nLED3 GPIO27 · LED4 GPIO32\nLED5 GPIO33\nEach GPIO → 330 Ω → LED anode\nLED cathodes → GND"];
  ground [shape=plaintext, label="COMMON GROUND reference\nESP32 · servo supply · servo · camera supply · camera"];
  usb [label="USB supply\ncontroller board input"];
  cam [label="AI-Thinker ESP32-CAM + OV2640\nmodule camera pins reserved\n5V input · GND"];
  camsupply [label="Separate regulated\n5-V camera supply"];
  wifi [shape=ellipse, label="Private Wi-Fi LAN"];
  server [label="Local computer\nFastAPI + Python camera ingest"];
  esp -> rfid [label="SPI: SCK18 / MISO19 / MOSI23\nSS13 / RST4"];
  esp -> oled [label="I²C: SDA21 / SCL22"];
  esp -> servo [label="GPIO14 PWM signal only"];
  servosupply -> servo [label="+5V only to servo"];
  esp -> leds [label="five digital outputs"];
  usb -> esp [label="board power"];
  esp -> ground [label="GND"];
  servosupply -> ground [label="negative"];
  cam -> ground [label="GND"];
  camsupply -> ground [label="negative"];
  camsupply -> cam [label="+5V to board input"];
  esp -> wifi [dir=both, label="JSON API and event reports"];
  cam -> wifi [label="HTTP JPEG capture"];
  wifi -> server [dir=both, label="LAN"];
  note [shape=note, label="Do not join independent +5V rails.\nDo not power servo from GPIO or ESP32 3V3.\nServo is a supervised tabletop model only."];
  servo -> note [style=dashed, arrowhead=none];
}
