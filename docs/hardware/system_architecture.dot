digraph system {
  graph [rankdir=LR, bgcolor=white, pad=0.25, nodesep=0.35, ranksep=0.6, fontname="Helvetica", labelloc=t, label="Smart Parking System — hardware and software blocks", fontsize=16];
  node [shape=box, style="solid", color=black, fontcolor=black, fontname="Helvetica", fontsize=10, margin="0.12,0.08", penwidth=1];
  edge [color=black, fontcolor=black, fontname="Helvetica", fontsize=9, arrowsize=0.7, penwidth=1];
  controller [label="ESP32 DevKit controller\nRC522 RFID · SSD1306 OLED\n5 occupancy LEDs · SG90 signal"];
  cam [label="AI-Thinker ESP32-CAM\nOV2640 JPEG snapshot\nseparate regulated supply"];
  wifi [shape=ellipse, label="Private 2.4 GHz Wi-Fi LAN"];
  ingest [label="Python camera ingest\nJPEG validation and forwarding"];
  subgraph cluster_server { label="Local computer"; color=black; style=solid;
    api [label="FastAPI\nRFID · events · occupancy · status"];
    db [shape=cylinder, label="SQLite\nslots · sessions · events"];
    vision [label="ROI occupancy processing\nconfidence and smoothing"];
    api -> db [label="transactions"];
    api -> vision [label="camera frames"];
    vision -> db [label="accepted observations"];
  }
  browser [label="Browser dashboard\n3D lot · event stream · status"];
  controller -> wifi [dir=both, label="HTTPS/HTTP JSON API\nentry/exit, status, event reports"];
  cam -> wifi [label="HTTP /capture"];
  wifi -> ingest [label="camera LAN"];
  ingest -> api [label="multipart JPEG"];
  api -> browser [dir=both, label="dashboard and APIs"];
}
